#!/usr/bin/env bash
# One command for everything. Usage: pointe start|attach|open|talk|doctor|status|log|context|pair|hub|node|key|join|local|apps|stop [args]
set -euo pipefail
export ORT_DISABLE_TELEMETRY="${ORT_DISABLE_TELEMETRY:-1}"  # onnxruntime phones Microsoft on import: no_telemetry.py
BIN="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PATH="$PATH:$HOME/.local/bin"  # where uv's installer puts uv: a session started before it ran does not have it on PATH
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  start)   exec "$BIN/claude-voice" "$@" ;;        # a new session, with Claude Code's channel
  attach)  exec "$BIN/claude-voice-attach" "$@" ;; # from inside a session; /pointe:voice runs this
  open)    exec "$BIN/voice-open" "$@" ;;
  talk)    exec "$BIN/voice-talk" "$@" ;;        # push to talk from any app: bind it to a system-wide shortcut
  doctor)  exec "$BIN/voice-doctor" "$@" ;;
  status)  exec "$BIN/voice-daemon" status ;;
  log)     exec "$BIN/voice-log" "$@" ;;
  context) exec "$BIN/voice-context" "$@" ;;
  stop)    exec "$BIN/voice-daemon" stop ;;
  pair)    cd "$BIN/.." && exec uv run --locked --project "$BIN/.." python -I pair.py "$@" ;;
  node)    ROOT="$BIN/.."; STATE="${CLAUDE_VOICE_STATE:-$HOME/.claude-voice}"  # this machine as a node: no Pipecat, no keys
           exec env UV_PROJECT_ENVIRONMENT="$STATE/node-env" uv run -q --locked --only-group node --project "$ROOT" python "$ROOT/node_cli.py" "$@" ;;
  hub)     cd "$BIN/.." && exec uv run --locked --project "$BIN/.." python -I hub_nodes.py "$@" ;;  # machines: invite, nodes, revoke
  key)     cd "$BIN/.." && exec uv run --locked --project "$BIN/.." python -I keys.py "$@" ;;
  local)   case "${1:-}" in
             off|stop|status) ;;  # nothing to install
             *) # The Mac and the key first: the libraries below are 1.1 GB on disk, for nothing on a Mac that cannot use them.
                uv run --locked --project "$BIN/.." python -I "$BIN/../local.py" check "$@" || exit 1
                compgen -G "$BIN/../.venv/lib/python*/site-packages/kokoro_onnx" >/dev/null \
                  || echo "Installing the local libraries once: about 290 MB to download, 1.1 GB on disk..." >&2
                uv sync --locked --quiet --extra local --project "$BIN/.." ;;  # Whisper and Kokoro run inside the daemon
           esac
           exec uv run --locked --project "$BIN/.." python -I "$BIN/../local.py" "$@" ;;  # fully local: no keys
  apps)    exec "$BIN/pointe-apps" "$@" ;;       # the iPhone and Mac apps, built from source: doctor, mac, ios
  join)    exec uv run --locked --project "$BIN/.." python -I "$BIN/../harnesses/join.py" "$@" ;;  # another harness: pointe join opencode
  leave)   exec uv run --locked --project "$BIN/.." python -I -c "import sys; sys.path.insert(0, \"$BIN/../harnesses\"); import join; join.main(sys.argv[1:], leave=True)" "$@" ;;
  *) sed -n 2p "${BASH_SOURCE[0]}" | cut -c3-; exit 2 ;;
esac
