#!/usr/bin/env bash
# One command for everything. Usage: pointe start|attach|open|doctor|status|log|context|pair|key|join|stop [args]
set -euo pipefail
BIN="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  start)   exec "$BIN/claude-voice" "$@" ;;        # a new session, with Claude Code's channel
  attach)  exec "$BIN/claude-voice-attach" "$@" ;; # from inside a session; /pointe:voice runs this
  open)    exec "$BIN/voice-open" "$@" ;;
  doctor)  exec "$BIN/voice-doctor" "$@" ;;
  status)  exec "$BIN/voice-daemon" status ;;
  log)     exec "$BIN/voice-log" "$@" ;;
  context) exec "$BIN/voice-context" "$@" ;;
  stop)    exec "$BIN/voice-daemon" stop ;;
  pair)    cd "$BIN/.." && exec uv run --no-sync --project "$BIN/.." python -I pair.py "$@" ;;
  key)     cd "$BIN/.." && exec uv run --no-sync --project "$BIN/.." python -I keys.py "$@" ;;
  join)    exec uv run --no-sync --project "$BIN/.." python -I "$BIN/../harnesses/join.py" "$@" ;;  # another harness: pointe join opencode
  leave)   exec uv run --no-sync --project "$BIN/.." python -I -c "import sys; sys.path.insert(0, \"$BIN/../harnesses\"); import join; join.main(sys.argv[1:], leave=True)" "$@" ;;
  *) sed -n 2p "${BASH_SOURCE[0]}" | cut -c3-; exit 2 ;;
esac
