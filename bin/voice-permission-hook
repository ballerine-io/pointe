#!/usr/bin/env bash
# Claude Code's PermissionRequest hook: lets the voice answer a prompt. Prints the decision; printing nothing leaves the
# prompt to the terminal, which is what happens when the daemon is down or this session is not on the voice.
STATE="${CLAUDE_VOICE_STATE:-$HOME/.claude-voice}"
PORT="${CLAUDE_VOICE_DAEMON_PORT:-7860}"
[ -r "$STATE/token" ] || exit 0
# The reply can approve a tool call, so it must come from our daemon (or node), not from whatever holds the port now.
# No lsof (a Linux box): ss, then /proc; with none of them, nothing is forwarded.
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$BIN/voice-ours" </dev/null || exit 0
# A daemon that is stopped (SIGSTOP) or hung still accepts the connection, and the wait below would hold the prompt for
# hours: one that does not answer its health check in a few seconds leaves the prompt to the terminal.
curl -sf --connect-timeout 1 --max-time 3 -o /dev/null "http://127.0.0.1:$PORT/voice/health" || exit 0
# The daemon lets an ordinary request go after 280 s. A session on a night shift is held until its user answers, for up to
# 12 hours: the wait here is as long as the hook's own timeout allows (hooks/hooks.json, 43500 s). A daemon that stops
# drops the connection, and the prompt is at the terminal.
# A Pointe of another version answers 426 with a sentence (voice-ask prints it on stderr): the prompt stays in the
# terminal, and Claude Code is never blocked or shown a traceback.
REPLY="$("$BIN/voice-ask" hook /voice/permission-hook --connect-timeout 1 --max-time 43490 \
  -H 'content-type: application/json' --data-binary @-)" || exit 0
[ "$REPLY" = "{}" ] || printf '%s\n' "$REPLY"
exit 0
