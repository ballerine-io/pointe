#!/usr/bin/env bash
# Put `pointe` on the PATH: ~/.local/bin/pointe, a small script (not a symlink, which would dangle once a plugin update
# deletes this folder) that runs this copy's bin/pointe. bin/install-uv runs it during setup, and bin/voice-daemon at each
# start, so it follows plugin updates. A ~/.local/bin/pointe that Pointe did not write is left alone; `pointe uninstall`
# removes Pointe's. Usage: link-pointe [--quiet]
set -euo pipefail
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="${POINTE_LINK_DIR:-$HOME/.local/bin}"
LINK="$DIR/pointe"
MARK="# Written by Pointe (bin/link-pointe): runs the Pointe plugin's own bin/pointe."
quiet() { [ "${1:-}" = "--quiet" ]; }

if [ -e "$LINK" ] && ! grep -qsF "$MARK" "$LINK"; then
  quiet "${1:-}" || echo "note     $LINK is not Pointe's: left as it is. Pointe's own command is $BIN/pointe"
  exit 0
fi
WANT="$(printf '#!/bin/bash\n%s\nexec %q "$@"\n' "$MARK" "$BIN/pointe")"
if [ "$(cat "$LINK" 2>/dev/null)" != "$WANT" ]; then
  mkdir -p "$DIR"
  printf '%s\n' "$WANT" >"$LINK.tmp.$$" && chmod 755 "$LINK.tmp.$$" && mv -f "$LINK.tmp.$$" "$LINK"
fi
quiet "${1:-}" && exit 0
echo "ok       pointe is a command now: $LINK runs Pointe (pointe uninstall removes it)"
case ":$PATH:" in
  *":$DIR:"*) ;;
  *) echo "note     $DIR is not on this terminal's PATH yet: open a new terminal (uv's installer adds it), or run $LINK" ;;
esac
