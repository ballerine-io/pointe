#!/usr/bin/env bash
# Register the current Claude Code session with the voice daemon.
# Reads the session from the environment (Bash tool) or from hook JSON on stdin (SessionStart).
# Usage: register-session [--channel-url URL] [--name NAME] [--start ID] [--quiet]
# --start: this session was started by Pointe (docs/design/new-session.md); the id tells the daemon which start it is.
set -euo pipefail

STATE="${CLAUDE_VOICE_STATE:-$HOME/.claude-voice}"
PORT="${CLAUDE_VOICE_DAEMON_PORT:-7860}"
CHANNEL_URL="" NAME="" QUIET="" START=""
while [ $# -gt 0 ]; do
  case "$1" in
    --channel-url) CHANNEL_URL="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --start) START="$2"; shift 2 ;;
    --quiet) QUIET=1; shift ;;
    *) echo "unknown arg $1" >&2; exit 2 ;;
  esac
done

SESSION_ID="${CLAUDE_CODE_SESSION_ID:-}"
TRANSCRIPT=""
if [ ! -t 0 ]; then  # hook mode: the event JSON carries the session id and transcript path
  HOOK="$(cat)"
  HOOK_ID="$(printf '%s' "$HOOK" | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null || true)"
  [ -n "$HOOK_ID" ] && SESSION_ID="$HOOK_ID"
  TRANSCRIPT="$(printf '%s' "$HOOK" | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("transcript_path",""))' 2>/dev/null || true)"
fi
[ -n "$SESSION_ID" ] || { echo "register-session: not inside a Claude Code session" >&2; exit 1; }
# Each Claude account (CLAUDE_CONFIG_DIR) keeps its own transcripts: look in this session's, and tell the daemon which.
CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
[ -n "$TRANSCRIPT" ] || TRANSCRIPT="$(find "$CONFIG_DIR/projects" -maxdepth 2 -name "$SESSION_ID.jsonl" | head -1)"
[ -n "$TRANSCRIPT" ] || TRANSCRIPT="$CONFIG_DIR/projects/unknown/$SESSION_ID.jsonl"

NAME_GIVEN=""; [ -n "$NAME" ] && NAME_GIVEN=1
if [ -z "$NAME" ]; then
  BRANCH="$(git -C "$PWD" branch --show-current 2>/dev/null || true)"
  NAME="$(basename "$PWD")"
  [ -n "$BRANCH" ] && [ "$BRANCH" != "$NAME" ] && NAME="$NAME/$BRANCH"  # worktrees named after their branch
fi

BODY="$(CONFIG_DIR="$CONFIG_DIR" SESSION_ID="$SESSION_ID" NAME="$NAME" NAME_GIVEN="$NAME_GIVEN" TRANSCRIPT="$TRANSCRIPT" CHANNEL_URL="$CHANNEL_URL" START="$START" \
  PID_="${CLAUDE_PID:-$PPID}" python3 -I -c '
import json, os
print(json.dumps({
    "id": os.environ["SESSION_ID"], "name": os.environ["NAME"], "cwd": os.getcwd(),
    "pid": int(os.environ["PID_"]), "transcript": os.environ["TRANSCRIPT"],
    "inbox_socket": os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET"),
    "inbox_token": os.environ.get("CLAUDE_CODE_MESSAGING_TOKEN"),
    "channel_url": os.environ.get("CHANNEL_URL") or None,
    "name_given": bool(os.environ.get("NAME_GIVEN")),
    "config_dir": os.environ["CONFIG_DIR"],
    **({"start": os.environ["START"]} if os.environ.get("START") else {}),
}))')"

# The token and the body (it holds the inbox token) go by file descriptor, never on a command line.
RESULT="$(printf %s "$BODY" | curl -sf -m 3 -X POST "http://127.0.0.1:$PORT/voice/register" \
  --config <(printf 'header = "Authorization: Bearer %s"\n' "$(cat "$STATE/token")") -H 'content-type: application/json' --data-binary @-)" || {
  [ -n "$QUIET" ] || echo "register-session: daemon not reachable on port $PORT" >&2; exit 1; }
[ -n "$QUIET" ] || echo "$RESULT"
