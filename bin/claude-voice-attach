#!/usr/bin/env bash
# Add the Claude Code session this runs in to the shared voice (run it from that session's Bash tool).
# Usage: claude-voice-attach [on|off|status|heard [SECS]] [--name NAME]
# Input reaches the session through its inbox socket; output is read from its transcript; no restart.
set -euo pipefail

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${CLAUDE_VOICE_DAEMON_PORT:-7860}"
STATE="${CLAUDE_VOICE_STATE:-$HOME/.claude-voice}"

case "${1:-on}" in
  status) "$BIN/voice-daemon" status; "$BIN/voice-ours" || exit 0; curl -sf --config <(printf 'header = "Authorization: Bearer %s"\n' "$(cat "$STATE/token")") "http://127.0.0.1:$PORT/voice/status" && echo; exit 0 ;;
  off)  # this session leaves the voice; it keeps running here, and /pointe:voice joins it again
    : "${CLAUDE_CODE_SESSION_ID:?run this from inside a Claude Code session}"
    "$BIN/voice-ours" || { echo "this session was not on the voice"; exit 0; }  # the token goes only to the daemon
    curl -sf --config <(printf 'header = "Authorization: Bearer %s"\n' "$(cat "$STATE/token")") -H 'Content-Type: application/json' \
      -d "{\"id\": \"$CLAUDE_CODE_SESSION_ID\"}" "http://127.0.0.1:$PORT/voice/disconnect" >/dev/null \
      && echo "this session left the voice; its permission prompts are back in this terminal" \
      || echo "this session was not on the voice"
    exit 0 ;;
  heard)  # /pointe:setup's first call: waits until Pointe answered the person's first words (daemon.py writes first-hello)
    [ -f "$STATE/first-hello" ] && { echo "Pointe has answered you on this Mac before. You're set up."; exit 0; }
    for _ in $(seq 1 "${2:-180}"); do
      [ -f "$STATE/first-hello" ] && { echo "Pointe heard you. You're set up."; exit 0; }
      sleep 1
    done
    echo "No first words heard yet. Is the page open? Press the orange Connect button; if Chrome asks for the microphone, press Allow. Then say hello."
    exit 1 ;;
  on) shift || true ;;
  --name) ;;
  *) echo "usage: claude-voice-attach [on|off|status|heard] [--name NAME]; stop everything with voice-daemon stop" >&2; exit 2 ;;
esac

[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || { echo "Pointe: run /pointe:voice inside a Claude Code session; it joins that session. Other agents: pointe join opencode or pointe join codex." >&2; exit 1; }
: "${CLAUDE_CODE_MESSAGING_SOCKET:?this session has no inbox socket (needs Claude Code 2.1.224+)}"
URL="$("$BIN/voice-daemon" ensure)"
RESULT="$("$BIN/register-session" "$@" </dev/null)"
echo "this session joined Pointe: $RESULT"
"$BIN/voice-ours" || { echo "Pointe: the program on port $PORT is not Pointe, or nothing here can tell (lsof, ss or /proc)" >&2; exit 1; }  # the token goes only to the daemon
# Whether a call is up, so the page opens only when none is. A refused or unreadable answer (a daemon from another
# version of Pointe, a 403 without the key) is said in words and the page still opens: never a traceback.
CONNECTED="$({ curl -sf --config <(printf 'header = "Authorization: Bearer %s"\n' "$(cat "$STATE/token")") "$URL/voice/status" 2>/dev/null || true; } \
  | python3 -I -c 'import json,sys
try: print(json.load(sys.stdin)["connected"])
except Exception: pass' 2>/dev/null || true)"
[ "$CONNECTED" = True ] || [ "$CONNECTED" = False ] || echo "Pointe: the voice did not say whether a call is up (its status was refused or unreadable). pointe doctor says whether an older Pointe plugin is installed next to a newer Pointe." >&2
[ -n "${CLAUDE_VOICE_NO_BROWSER:-}" ] || [ "$CONNECTED" = True ] || "$BIN/voice-open"
echo "For the person (nothing here waits on them, and nothing is for you to do): they talk in the voice tab or the phone app;"
echo "$BIN/voice-open opens the tab again. Stop all voice with: $BIN/voice-daemon stop"
echo "Permission prompts are read out, and a spoken yes or no answers them. Hang up, and they go back to this terminal."
echo "A spoken yes to a question the session asks in conversation may not count: Claude Code treats those words as another"
echo "session's message, so it can ask you to type before it sends, merges or deletes."
echo "To see what the voice heard, said and knows: $BIN/voice-log --call, $BIN/voice-context (or /pointe:voice-review)."
echo "Reply with one line: this session joined Pointe."
