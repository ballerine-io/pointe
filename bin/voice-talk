#!/usr/bin/env bash
# Push to talk from any app: open or close the microphone on the call that is up. Bind it to a system-wide shortcut
# (Settings → Microphone on the page shows the recipe); a hold-to-talk tool runs `on` on key down and `off` on key up.
#   voice-talk            toggle: press once to talk, again to stop
#   voice-talk on|off
# Prints one line and exits 0, or 1 with the reason (no call, microphone set to Always on, Pointe not running).
set -euo pipefail
PORT="${CLAUDE_VOICE_DAEMON_PORT:-7860}"
STATE="${CLAUDE_VOICE_STATE:-$HOME/.claude-voice}"
ACTION="${1:-toggle}"
case "$ACTION" in on|off|toggle) ;; *) echo "voice-talk: on, off or toggle" >&2; exit 2 ;; esac
[ -r "$STATE/token" ] || { echo "Pointe is not running on this Mac."; exit 1; }
# Only to the daemon itself: with it down, another program on the port would get the token.
"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/voice-ours" || { echo "Pointe is not running on this Mac."; exit 1; }
# The token goes through a curl config on a pipe, never an argument, so it shows in no process list.
# voice-ask: the body on a 200, else one sentence (the daemon's own reason, or what another version of Pointe means).
if BODY="$("$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/voice-ask" cli /voice/talk -m 5 -X POST -H 'content-type: application/json' \
    --data "{\"action\": \"$ACTION\"}" 2>&1)"; then
  case "$BODY" in *'"open": true'*|*'"open":true'*) echo "Talking." ;; *) echo "Not talking." ;; esac
  exit 0
fi
echo "${BODY#Pointe: }"
exit 1
